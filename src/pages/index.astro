---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Image } from 'astro:assets';
import profileImage from '../assets/Profile.jpg';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 800px;
				margin: 0 auto;
				padding: 3em 1em;
			}
			.profile-header {
				border-bottom: 2px solid var(--accent);
				margin-bottom: 3rem;
				padding-bottom: 0.5rem;
			}
			h1 {
				color: var(--heading-color);
			}
			h2 {
				color: var(--accent);
				border-left: 4px solid var(--accent);
				padding-left: 15px;
				margin-top: 3rem;
				font-size: 1.4rem;
			}
			h3 {
				color: var(--heading-color);
				font-size: 1.1rem;
				margin-top: 1.5rem;
			}
			p, li {
				line-height: 1.8;
			}
			.lab-info {
				background: var(--box-bg);
				padding: 1.2rem;
				border-radius: 8px;
				border-left: 4px solid var(--accent);
				margin: 1rem 0;
			}
			.contact-box {
				margin-top: 2rem;
				padding: 1rem 2rem;
				border: 1px solid var(--box-border);
				border-radius: 12px;
				text-align: center;
			}
			.contact-box h3 {
				margin-top: 0;         
				margin-bottom: 0.5rem; 
			}
			.email-link {
				color: var(--accent);
				text-decoration: none;
				font-weight: bold;
				font-size: 1.1rem;
			}
			.email-link:hover {
				text-decoration: underline;
			}
			.profile-img-container {
				display: flex;
				justify-content: center; /* 中央寄せ */
				margin-bottom: 1.5rem;
			}

			.profile-img {
				width: 150px;           /* 画像のサイズ */
				height: 150px;
				border-radius: 50%;     /* 正円にする */
				object-fit: cover;      /* 縦横比を維持して切り抜き */
				border: 3px solid var(--accent); /* 他のページと共通のシアンの枠線 */
				box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="profile-header">
				<h1>About Me</h1>
				<div class="profile-img-container">
					<Image src={profileImage} alt="杉田 大知" class="profile-img" />
				</div>
				<h4>静岡大学大学院 修士1年 / 杉田 大知 (Sugita Daichi)</h4>
			</div>

			<section>
				<h2>自己紹介</h2>
				<div class="section-content">
					<p>
						静岡大学大学院 総合科学技術研究科の杉田大知です。<br />
						現在は、画像生成AIにおける追加学習モデル（LoRA）の検索および統合手法に関する研究を行っています。
					</p>
					<p>
						また、<strong>LINEヤフー株式会社様との共同研究</strong>に従事しており、実社会の課題解決に向けた大規模モデルの活用・応用技術の開発に取り組んでいます。
					</p>
				</div>
			</section>

			<section>
				<h2>所属</h2>
				<div class="section-content lab-info">
					<p>
						<strong>静岡大学大学院 総合科学技術研究科 情報学専攻 莊司研究室</strong><br />
						（修士課程 1年）
					</p>
					<p style="margin-top: 10px; font-size: 0.9rem; color: #888;">
						静岡大学 情報学部 行動情報学科 卒業
					</p>
				</div>
			</section>

			<section>
				<h2>研究テーマ・関心領域</h2>
				<div class="section-content">
					<p>
						情報検索、画像処理、機械学習、自然言語処理、組み合わせ探索
					</p>
				</div>
			</section>

			<section>
				<h2>趣味</h2>
				<div class="section-content">
					<ul>
						<li>ランニング</li>
						<li>ゲーム</li>
						<li>スポーツ全般</li>
					</ul>
				</div>
			</section>

			<section class="contact-box">
    			<h3>Contact</h3>
   				 <a href="mailto:daichi.sugita323@gmail.com" class="email-link">
       				 daichi.sugita323@gmail.com
   				 </a>
			</section>
		</main>
		<Footer />
	</body>
</html>