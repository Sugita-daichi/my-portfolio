---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`Awards | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 800px;
				margin: 0 auto;
				padding: 3em 1em;
			}
			h1 {
				color: var(--heading-color);
				border-bottom: 2px solid var(--accent);
				padding-bottom: 0.5rem;
				margin-bottom: 3rem;
			}
			.group-title {
				font-size: 1.5rem;
				color: var(--heading-color);
				margin: 3rem 0 1.5rem 0;
				display: flex;
				align-items: center;
				gap: 0.8rem;
			}
			.group-title::before {
				content: "";
				display: inline-block;
				width: 8px;
				height: 24px;
				background: var(--accent);
				border-radius: 2px;
			}
			.award-card {
				background: var(--box-bg);
				border: 1px solid var(--box-border);
				border-radius: 12px;
				padding: 1.5rem;
				margin-bottom: 1.5rem;
				position: relative;
				overflow: hidden;
			}
			/* 受賞カードの左側にアクセントの帯を追加 */
			.award-card::after {
				content: "";
				position: absolute;
				top: 0;
				left: 0;
				width: 6px;
				height: 100%;
				background: var(--accent);
			}
			.award-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1rem;
			}
			.award-name {
				color: var(--accent);
				font-size: 1.25rem;
				font-weight: bold;
				margin: 0;
			}
			.award-date {
				font-size: 0.9rem;
				opacity: 0.7;
				font-weight: bold;
			}
			.award-comment {
				font-size: 0.95rem;
				line-height: 1.6;
				padding-top: 0.8rem;
				border-top: 1px dashed var(--box-border);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Awards</h1>

			<h2 class="group-title">Research Awards</h2>
			<div class="award-card">
				<div class="award-header">
					<p class="award-name">東海関西データベースワークショップ2025 優秀賞</p>
					<span class="award-date">2025</span>
				</div>
				<div class="award-comment">
					<p>
						画像検索とLoRA統合に関する初期段階の研究が高く評価されました。この受賞が、その後の国際会議採択に向けた大きな励みとなりました。
					</p>
				</div>
			</div>

		</main>
		<Footer />
	</body>
</html>